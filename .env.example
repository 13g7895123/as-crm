# ============================================
# CRM RBAC - Environment Configuration Example
# ============================================
#
# 此檔案僅供參考，實際使用請參考：
#   - .env.dev  （開發環境）
#   - .env.prod （生產環境）
#
# 腳本會自動使用對應的環境檔案：
#   - ./develop.sh    → 使用 .env.dev
#   - ./production.sh → 使用 .env.prod
#
# ============================================

# ============================================
# 🌐 對外服務 PORT（最重要，放最上面）
# ============================================
# 開發環境建議使用 9xxx 系列 port
# 生產環境使用標準 port (80, 443)

# Nginx (生產環境)
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# 開發環境對外 Port
DB_PORT=9130
BACKEND_PORT=9230
FRONTEND_PORT=9330
FRONTEND_HMR_PORT=24678
PHPMYADMIN_PORT=9730

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_HOST=database
DB_NAME=crm_db
DB_USER=crm_user
DB_PASSWORD=crm_password
DB_ROOT_PASSWORD=root_password

# ============================================
# BACKEND CONFIGURATION
# ============================================
CI_ENVIRONMENT=development
JWT_SECRET_KEY=dev-secret-key-change-in-production
JWT_TIME_TO_LIVE=3600
JWT_REFRESH_TIME_TO_LIVE=604800

# ============================================
# FRONTEND CONFIGURATION
# ============================================
NUXT_PUBLIC_API_BASE_URL=http://localhost:${BACKEND_PORT}/api/v1
NUXT_PUBLIC_APP_NAME="CRM 系統"

# ============================================
# CORS CONFIGURATION
# ============================================
CORS_ALLOWED_ORIGINS=http://localhost:${FRONTEND_PORT}
