# ============================================
# Backend Development Dockerfile
# ============================================
# 用於開發環境的 PHP 8.1 CLI 映像
# 支援 Hot Reload（透過 volume mount）

FROM php:8.1-cli

LABEL maintainer="CRM RBAC Team"
LABEL description="CRM RBAC Backend Development Environment"

# 安裝系統依賴套件
RUN apt-get update && apt-get install -y \
    git \
    curl \
    libpng-dev \
    libonig-dev \
    libxml2-dev \
    zip \
    unzip \
    libicu-dev \
    libzip-dev \
    && docker-php-ext-install \
        pdo_mysql \
        mysqli \
        mbstring \
        exif \
        pcntl \
        bcmath \
        gd \
        intl \
        zip \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# 安裝 APCu 快取擴充（用於應用程式層級快取）
RUN pecl install apcu && docker-php-ext-enable apcu

# PHP 開發環境配置
RUN { \
    echo 'display_errors = On'; \
    echo 'error_reporting = E_ALL'; \
    echo 'log_errors = On'; \
    echo 'memory_limit = 512M'; \
    echo 'post_max_size = 20M'; \
    echo 'upload_max_filesize = 20M'; \
    echo 'max_execution_time = 60'; \
} > /usr/local/etc/php/conf.d/development.ini

# APCu 開發配置
RUN { \
    echo 'apc.enable_cli=1'; \
    echo 'apc.shm_size=64M'; \
} > /usr/local/etc/php/conf.d/apcu.ini

# 安裝 Composer（最新版本）
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# 設定工作目錄
WORKDIR /var/www/html

# 複製 composer 檔案
COPY composer.json composer.lock* ./

# 安裝 PHP 依賴套件（開發環境包含 dev 依賴）
RUN composer install \
    --no-interaction \
    --prefer-dist \
    --optimize-autoloader \
    --no-scripts

# 複製應用程式檔案
COPY . .

# 設定權限（開發環境使用寬鬆權限）
RUN chmod -R 777 writable public/uploads 2>/dev/null || true

# 執行 Composer 後續腳本
RUN composer dump-autoload --optimize

# 開放 8080 port（PHP 內建開發伺服器）
EXPOSE 8080

# 健康檢查
HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
    CMD php -r "echo 'OK';" || exit 1

# 啟動 PHP 內建開發伺服器
# 注意: docker-compose.yml 會覆寫此 CMD
CMD ["php", "-S", "0.0.0.0:8080", "-t", "public"]
