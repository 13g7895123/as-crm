# ============================================
# CRM RBAC - Development Environment Configuration
# ============================================
# 開發環境專用配置
#
# 使用方式：
#   ./develop.sh 會自動使用此配置
#
# ============================================

# ============================================
# PORT CONFIGURATION - Development
# ============================================
# 開發環境使用的對外 Port
DB_PORT=9130
BACKEND_PORT=9230
FRONTEND_PORT=9330
FRONTEND_HMR_PORT=24678
PHPMYADMIN_PORT=9730

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_HOST=database
DB_NAME=crm_db
DB_USER=crm_user
DB_PASSWORD=crm_password
DB_ROOT_PASSWORD=root_password

# ============================================
# BACKEND CONFIGURATION
# ============================================
CI_ENVIRONMENT=development
JWT_SECRET_KEY=dev-secret-key-change-in-production-12345678901234567890123456789012
JWT_TIME_TO_LIVE=3600
JWT_REFRESH_TIME_TO_LIVE=604800

# ============================================
# FRONTEND CONFIGURATION
# ============================================
NUXT_PUBLIC_API_BASE_URL=http://localhost:9230/api/v1
NUXT_PUBLIC_APP_NAME="CRM 權限管理系統 (開發)"

# ============================================
# CORS CONFIGURATION
# ============================================
CORS_ALLOWED_ORIGINS=http://localhost:9330,http://localhost:3001

# ============================================
# NOTES
# ============================================
# - 開發環境前端通常使用 npm run dev 在 port 3001 運行
# - Backend API 在 port 9230
# - phpMyAdmin 在 port 9730
# - 所有 port 都使用 9xxx 系列避免與其他服務衝突
