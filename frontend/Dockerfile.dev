# ============================================
# Frontend Development Dockerfile
# ============================================
# 用於開發環境的 Node.js 映像
# 支援 HMR (Hot Module Replacement)

FROM node:20-alpine

LABEL maintainer="CRM RBAC Team"
LABEL description="CRM RBAC Frontend Development Environment"

# 安裝基本工具
RUN apk add --no-cache \
    git \
    curl

# 設定工作目錄
WORKDIR /app

# 複製 package 檔案
COPY package*.json ./

# 安裝依賴套件（包含 dev 依賴）
# 使用 --legacy-peer-deps 來處理依賴衝突
RUN npm install --legacy-peer-deps

# 複製應用程式檔案
COPY . .

# 開放 Nuxt 開發伺服器 port
EXPOSE 3000

# 開放 Vite HMR port
EXPOSE 24678

# 設定環境變數
ENV NODE_ENV=development
ENV HOST=0.0.0.0
ENV PORT=3000

# 健康檢查
HEALTHCHECK --interval=30s --timeout=3s --start-period=60s --retries=3 \
    CMD node --version || exit 1

# 啟動 Nuxt 開發伺服器
# 注意: docker-compose.yml 會覆寫此 CMD
CMD ["npm", "run", "dev"]
