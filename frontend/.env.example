# ====================================================================
# Frontend Environment Configuration (Nuxt 3)
# ====================================================================
#
# IMPORTANT: Copy this file to .env and update with your actual values
# DO NOT commit .env to version control
#
# ====================================================================

# --------------------------------------------------------------------
# ENVIRONMENT
# --------------------------------------------------------------------

# Environment mode: development, staging, production
NODE_ENV=development

# --------------------------------------------------------------------
# API CONFIGURATION
# --------------------------------------------------------------------

# Backend API base URL
# Development: Point to local backend
# Production: Point to production API server
NUXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# API timeout in milliseconds
NUXT_PUBLIC_API_TIMEOUT=30000

# --------------------------------------------------------------------
# APPLICATION CONFIGURATION
# --------------------------------------------------------------------

# Application name
NUXT_PUBLIC_APP_NAME=CRM RBAC System

# Application version
NUXT_PUBLIC_APP_VERSION=1.0.0

# Base URL for the application
NUXT_PUBLIC_BASE_URL=http://localhost:3000

# --------------------------------------------------------------------
# AUTHENTICATION
# --------------------------------------------------------------------

# JWT token storage key
NUXT_PUBLIC_TOKEN_KEY=crm_rbac_token

# JWT refresh token storage key
NUXT_PUBLIC_REFRESH_TOKEN_KEY=crm_rbac_refresh_token

# Session timeout in minutes
NUXT_PUBLIC_SESSION_TIMEOUT=60

# Auto logout on token expiry
NUXT_PUBLIC_AUTO_LOGOUT=true

# --------------------------------------------------------------------
# PAGINATION
# --------------------------------------------------------------------

# Default items per page
NUXT_PUBLIC_DEFAULT_PAGE_SIZE=20

# Available page size options
NUXT_PUBLIC_PAGE_SIZE_OPTIONS=10,20,50,100

# --------------------------------------------------------------------
# UI CONFIGURATION
# --------------------------------------------------------------------

# Default locale
NUXT_PUBLIC_DEFAULT_LOCALE=zh-TW

# Available locales
NUXT_PUBLIC_AVAILABLE_LOCALES=zh-TW,en-US

# Date format
NUXT_PUBLIC_DATE_FORMAT=YYYY-MM-DD

# DateTime format
NUXT_PUBLIC_DATETIME_FORMAT=YYYY-MM-DD HH:mm:ss

# Timezone
NUXT_PUBLIC_TIMEZONE=Asia/Taipei

# --------------------------------------------------------------------
# LOGGING
# --------------------------------------------------------------------

# Enable console logging
NUXT_PUBLIC_ENABLE_LOGGING=true

# Log level: debug, info, warn, error
NUXT_PUBLIC_LOG_LEVEL=debug

# --------------------------------------------------------------------
# PERFORMANCE
# --------------------------------------------------------------------

# Enable service worker
NUXT_PUBLIC_ENABLE_SERVICE_WORKER=false

# Enable offline mode
NUXT_PUBLIC_ENABLE_OFFLINE=false

# Cache API responses (in seconds, 0 to disable)
NUXT_PUBLIC_API_CACHE_TTL=0

# --------------------------------------------------------------------
# SECURITY
# --------------------------------------------------------------------

# Enable HTTPS only mode in production
NUXT_PUBLIC_HTTPS_ONLY=false

# Enable CSRF protection
NUXT_PUBLIC_CSRF_ENABLED=true

# Enable XSS protection
NUXT_PUBLIC_XSS_PROTECTION=true

# --------------------------------------------------------------------
# FEATURE FLAGS
# --------------------------------------------------------------------

# Enable audit log viewer
NUXT_PUBLIC_FEATURE_AUDIT_LOGS=true

# Enable role hierarchy management
NUXT_PUBLIC_FEATURE_ROLE_HIERARCHY=true

# Enable time-based role assignments
NUXT_PUBLIC_FEATURE_TIME_BASED_ROLES=true

# Enable advanced permission filtering
NUXT_PUBLIC_FEATURE_ADVANCED_PERMISSIONS=true

# Enable bulk operations
NUXT_PUBLIC_FEATURE_BULK_OPERATIONS=true

# --------------------------------------------------------------------
# DEVELOPMENT
# --------------------------------------------------------------------

# Enable Nuxt DevTools
NUXT_DEVTOOLS_ENABLED=true

# Enable source maps in production
NUXT_PUBLIC_SOURCE_MAPS=false

# Enable telemetry
NUXT_TELEMETRY_DISABLED=true

# --------------------------------------------------------------------
# BUILD CONFIGURATION
# --------------------------------------------------------------------

# Enable server-side rendering
NUXT_SSR=false

# Target: server, static
NUXT_TARGET=static

# --------------------------------------------------------------------
# ERROR TRACKING (Optional)
# --------------------------------------------------------------------

# Sentry DSN (if using Sentry for error tracking)
# NUXT_PUBLIC_SENTRY_DSN=

# Sentry environment
# NUXT_PUBLIC_SENTRY_ENVIRONMENT=development

# --------------------------------------------------------------------
# ANALYTICS (Optional)
# --------------------------------------------------------------------

# Google Analytics ID (if using GA)
# NUXT_PUBLIC_GA_ID=

# Enable analytics
# NUXT_PUBLIC_ENABLE_ANALYTICS=false
